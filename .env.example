# Environment Configuration for zes-agent-hub
# Copy this file to .env and fill in your values

# =============================================================================
# Required: AgoraHub Core
# =============================================================================
# PostgreSQL connection string. When unset the Hub falls back to PGlite
# (PostgreSQL compiled to WASM) — development and tests only.
DATABASE_URL=postgres://user:password@localhost:5432/zes_agent_hub
PGLITE_DATA_DIR=./data/pglite
AGORA_HUB_URL=http://localhost:8765
AGORA_HUB_ADMIN_KEY=your_admin_key_here
AGORA_HUB_DB_PATH=./data/agora.db
AGORA_HUB_PORT=8765

# =============================================================================
# Required: ZESCODE API gateway (new-api) — default provider
# =============================================================================
# The hub calls the ZESCODE gateway through its OpenAI-compatible surface. The
# gateway routes across its own channels (Pollinations, APInex, Kilo, NVIDIA),
# keeps the billing trail and the audit log. The hub holds one gateway token
# and never sees an upstream key.
NEW_API_BASE_URL=https://api.zes.codes/v1
NEW_API_API_KEY=your_zESCODE_gateway_token_here
# Model used when a seat does not name one. Must be listed by
# GET {NEW_API_BASE_URL}/models.
NEW_API_DEFAULT_MODEL=deepseek-v4.1-flash
# Flat estimate used for model_usage when the gateway does not report a cost.
NEW_API_COST_PER_MILLION_TOKENS=0.5

# =============================================================================
# Optional: Pollinations provider (parallel, not a silent fallback)
# =============================================================================
# Get your key from https://enter.pollinations.ai
# Never commit a real key here. Use .env (gitignored) for actual values.
POLLINATIONS_API_KEY=your_pollinations_api_key_here
POLLINATIONS_API_BASE=https://gen.pollinations.ai
POLLINATIONS_GATEWAY_URL=https://gen.pollinations.ai/v1
POLLINATIONS_DEFAULT_MODEL=
POLLINATIONS_COST_PER_MILLION_TOKENS=0.5

# =============================================================================
# Optional: APInexGate provider (parallel reseller gateway)
# =============================================================================
# APInexGate is an OpenAI-compatible gateway that keeps its own billing,
# rate limits and audit trail. The hub holds one customer key and never sees
# the gateway's upstream key. Set APINEXGATE_DEFAULT_MODEL to a model id
# listed by GET {APINEXGATE_BASE_URL}/models. A seat has to name it explicitly:
# APInexGate is never used as an implicit fallback.
APINEXGATE_BASE_URL=http://127.0.0.1:8787/v1
APINEXGATE_API_KEY=your_apinexgate_customer_key_here
APINEXGATE_DEFAULT_MODEL=
# Flat estimate used for model_usage when the gateway does not report a cost.
APINEXGATE_COST_PER_MILLION_TOKENS=0.5

# =============================================================================
# Optional: Kilo Gateway (fallback models)
# =============================================================================
# Optional fallback provider. Never commit a real token here.
KILO_API_KEY=your_kilo_api_key_here
KILO_GATEWAY_URL=https://api.kilo.ai/api/gateway

# =============================================================================
# Required: Vercel
# =============================================================================
VERCEL_API_KEY=your_vercel_api_key_here
VERCEL_TEAM_ID=your_vercel_team_id
VERCEL_PROJECT_ID=your_vercel_project_id

# =============================================================================
# Required: Cloudflare
# =============================================================================
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here

# =============================================================================
# Cloudflare Pages project used by the deploy pipeline
CLOUDFLARE_PAGES_PROJECT=zes-sites

# Seat Model Assignments (nickname@model)
# =============================================================================
# castor@deepseek-v4.1-flash (orchestrator)
# john@gpt-6-astra (council)
# siti@claude-opus-5.5 (council)
# laurent@grok-4.7 (council)
# labu@deepseek-v4.1-flash (council, deployment)

POLLINATIONS_MODEL_ORCHESTRATOR=deepseek/deepseek-v4.1-flash
POLLINATIONS_MODEL_CASTOR=deepseek/deepseek-v4.1-flash
POLLINATIONS_MODEL_JOHN=openai/gpt-6-astra
POLLINATIONS_MODEL_SITI=openai/gpt-6.1-terra
POLLINATIONS_MODEL_LAURENT=x-ai/grok-4.6
POLLINATIONS_MODEL_LABU=deepseek/deepseek-v4.1-flash

# =============================================================================
# Pipeline Configuration
# =============================================================================
PIPELINE_NAME=vercel-cloudflare-build-deploy
PIPELINE_TEMPLATE=https://zes.codes
ZES_CODES_PATH=/data/data/com.termux/files/home/tmp/vercel/zes.codes

# =============================================================================
# Seat Configuration
# =============================================================================
SEATS_CONFIG_PATH=./seats/config.json
DRIVE_LOOP_INTERVAL_MS=30000
COUNCIL_CHANNEL_NAME=council-channel

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
LOG_DIR=./logs
