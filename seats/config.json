{
  "version": "0.1.0",
  "hub": {
    "url": "http://localhost:8765",
    "protocol": "agora/0.4",
    "adminKeyEnv": "AGORA_HUB_ADMIN_KEY"
  },
  "councilChannel": "council-channel",
  "driveLoopIntervalMs": 30000,
  "seats": [
    {
      "id": "castor",
      "type": "operator",
      "role": "orchestrator",
      "nicknameModel": "castor@deepseek-v4.1-flash",
      "model": "deepseek-v4.1-flash",
      "provider": "pollinations",
      "mission": "Orchestrator seat — receives user prompts, routes to council channel, synthesizes consensus, directs execution, posts final results",
      "capabilities": ["routing", "synthesis", "task-delegation", "result-aggregation", "vercel-deploy", "cloudflare-deploy"]
    },
    {
      "id": "john",
      "type": "member",
      "role": "council",
      "nicknameModel": "john@gpt-6-astra",
      "model": "gpt-6-astra",
      "provider": "pollinations",
      "mission": "Council member — strategic analysis, architecture planning, high-level decision making",
      "capabilities": ["strategy", "architecture", "decision-making", "planning"]
    },
    {
      "id": "siti",
      "type": "member",
      "role": "council",
      "nicknameModel": "siti@claude-opus-5.5",
      "model": "claude-opus-5.5",
      "provider": "pollinations",
      "mission": "Council member — creative direction, content strategy, user experience design",
      "capabilities": ["creative", "content", "ux-design", "writing"]
    },
    {
      "id": "laurent",
      "type": "member",
      "role": "council",
      "nicknameModel": "laurent@grok-4.7",
      "model": "grok-4.7",
      "provider": "pollinations",
      "mission": "Council member — technical implementation, code review, system architecture",
      "capabilities": ["implementation", "code-review", "system-design", "debugging"]
    },
    {
      "id": "labu",
      "type": "member",
      "role": "council",
      "nicknameModel": "labu@deepseek-v4.1-flash",
      "model": "deepseek-v4.1-flash",
      "provider": "pollinations",
      "mission": "Council member — deployment coordination, Vercel + Cloudflare pipeline management, infrastructure",
      "capabilities": ["deployment", "infrastructure", "vercel", "cloudflare", "devops"]
    }
  ],
  "delegations": [
    {
      "from": "castor",
      "to": "john",
      "type": "reporting",
      "description": "castor delegates strategic reporting to john"
    },
    {
      "from": "castor",
      "to": "siti",
      "type": "reporting",
      "description": "castor delegates creative reporting to siti"
    },
    {
      "from": "castor",
      "to": "laurent",
      "type": "reporting",
      "description": "castor delegates technical reporting to laurent"
    },
    {
      "from": "castor",
      "to": "labu",
      "type": "reporting",
      "description": "castor delegates deployment reporting to labu"
    }
  ],
  "pollinations": {
    "apiKeyEnv": "POLLINATIONS_API_KEY",
    "apiBase": "https://api.pollinations.ai",
    "gatewayUrl": "https://api.pollinations.ai/v1",
    "models": {
      "castor": "deepseek-v4.1-flash",
      "john": "gpt-6-astra",
      "siti": "claude-opus-5.5",
      "laurent": "grok-4.7",
      "labu": "deepseek-v4.1-flash"
    }
  },
  "kilo": {
    "apiKeyEnv": "KILO_API_KEY",
    "gatewayUrl": "https://api.kilo.ai/api/gateway",
    "fallbackModels": [
      "kilo-deepseek-v4.1-flash",
      "kilo-gpt-6-astra",
      "kilo-claude-opus-5.5",
      "kilo-grok-4.7"
    ]
  },
  "pipeline": {
    "name": "vercel-cloudflare-build-deploy",
    "stages": [
      "build",
      "vercel-deploy",
      "cloudflare-deploy"
    ],
    "template": "https://zes.codes",
    "localPath": "/data/data/com.termux/files/home/tmp/vercel/zes.codes"
  }
}
