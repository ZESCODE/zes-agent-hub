{
  "version": "0.1.0",
  "hub": {
    "url": "http://localhost:8765",
    "protocol": "agora/0.4",
    "adminKeyEnv": "AGORA_HUB_ADMIN_KEY"
  },
  "councilChannel": "council-channel",
  "driveLoopIntervalMs": 30000,
  "seats": [
    {
      "id": "castor",
      "type": "operator",
      "role": "orchestrator",
      "nicknameModel": "castor@deepseek-v4.1-flash",
      "model": "deepseek-v4.1-flash",
      "provider": "newapi",
      "mission": "Orchestrator seat \u2014 receives user prompts, routes to council channel, synthesizes consensus, directs execution, posts final results",
      "capabilities": [
        "routing",
        "synthesis",
        "task-delegation",
        "result-aggregation",
        "vercel-deploy",
        "cloudflare-deploy"
      ]
    },
    {
      "id": "john",
      "type": "member",
      "role": "council",
      "nicknameModel": "john@gpt-6.2-astra",
      "model": "gpt-6.2-astra",
      "provider": "newapi",
      "mission": "Council member \u2014 strategic analysis, architecture planning, high-level decision making",
      "capabilities": [
        "strategy",
        "architecture",
        "decision-making",
        "planning"
      ]
    },
    {
      "id": "siti",
      "type": "member",
      "role": "council",
      "nicknameModel": "siti@gpt-6.1-terra",
      "model": "gpt-6.1-terra",
      "provider": "newapi",
      "mission": "Council member \u2014 creative direction, content strategy, user experience design",
      "capabilities": [
        "creative",
        "content",
        "ux-design",
        "writing"
      ]
    },
    {
      "id": "laurent",
      "type": "member",
      "role": "council",
      "nicknameModel": "laurent@grok-4.7",
      "model": "grok-4.7",
      "provider": "newapi",
      "mission": "Council member \u2014 technical implementation, code review, system architecture",
      "capabilities": [
        "implementation",
        "code-review",
        "system-design",
        "debugging"
      ]
    },
    {
      "id": "labu",
      "type": "member",
      "role": "council",
      "nicknameModel": "labu@kimi-k3.1-pro",
      "model": "kimi-k3.1-pro",
      "provider": "newapi",
      "mission": "Council member \u2014 deployment coordination, Vercel + Cloudflare pipeline management, infrastructure",
      "capabilities": [
        "deployment",
        "infrastructure",
        "vercel",
        "cloudflare",
        "devops"
      ]
    }
  ],
  "delegations": [
    {
      "from": "castor",
      "to": "john",
      "type": "reporting",
      "description": "castor delegates strategic reporting to john"
    },
    {
      "from": "castor",
      "to": "siti",
      "type": "reporting",
      "description": "castor delegates creative reporting to siti"
    },
    {
      "from": "castor",
      "to": "laurent",
      "type": "reporting",
      "description": "castor delegates technical reporting to laurent"
    },
    {
      "from": "castor",
      "to": "labu",
      "type": "reporting",
      "description": "castor delegates deployment reporting to labu"
    }
  ],
  "pollinations": {
    "apiKeyEnv": "POLLINATIONS_API_KEY",
    "apiBase": "https://gen.pollinations.ai",
    "gatewayUrl": "https://gen.pollinations.ai/v1",
    "models": {
      "castor": "deepseek/deepseek-v4.1-flash",
      "john": "openai/gpt-6-astra",
      "siti": "openai/gpt-6.1-terra",
      "laurent": "x-ai/grok-4.6",
      "labu": "deepseek/deepseek-v4.1-flash"
    }
  },
  "kilo": {
    "apiKeyEnv": "KILO_API_KEY",
    "gatewayUrl": "https://api.kilo.ai/api/gateway",
    "fallbackModels": [
      "kilo-deepseek/deepseek-v4.1-flash",
      "kilo-gpt-6-astra",
      "kilo-claude-opus-5.5",
      "kilo-grok-4.7"
    ]
  },
  "pipeline": {
    "name": "vercel-cloudflare-build-deploy",
    "stages": [
      "build",
      "vercel-deploy",
      "cloudflare-deploy"
    ],
    "template": "https://zes.codes",
    "localPath": "/data/data/com.termux/files/home/tmp/vercel/zes.codes"
  },
  "newapi": {
    "apiKeyEnv": "NEW_API_API_KEY",
    "baseUrl": "https://api.zes.codes/v1",
    "defaultModel": "deepseek-v4.1-flash",
    "note": "ZESCODE API gateway (new-api). The gateway routes across its own channels and keeps the billing trail."
  },
  "qc": {
    "provider": "newapi",
    "reviewers": [
      "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
    ],
    "note": "Vision reviewers have to be models that accept image input."
  }
}
