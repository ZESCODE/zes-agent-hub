{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/index.js"
    },
    {
      "src": "/healthz",
      "dest": "/server/index.js"
    },
    {
      "src": "/health",
      "dest": "/server/index.js"
    },
    {
      "src": "/ready",
      "dest": "/server/index.js"
    },
    {
      "src": "/metrics",
      "dest": "/server/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "POLLINATIONS_API_KEY": "@pollinations-api-key",
    "KILO_API_KEY": "@kilo-api-key",
    "AGORA_HUB_ADMIN_KEY": "@agora-hub-admin-key",
    "VERCEL_API_KEY": "@vercel-api-key",
    "CLOUDFLARE_API_TOKEN": "@cloudflare-api-token",
    "CLOUDFLARE_ACCOUNT_ID": "@cloudflare-account-id",
    "AGORA_HUB_PORT": "3000",
    "DATABASE_URL": "@database-url"
  }
}
